# Keep line endings deterministic. Without this, Windows checkouts can rewrite
# every text file to CRLF, which then differs from what was tested.
* text=auto eol=lf

# Never touch these: they are binary and any rewriting corrupts them.
*.wasm binary
*.zip  binary
*.png  binary
*.jpg  binary
*.ico  binary

# Vendored third-party code: keep it out of diffs and language statistics.
vendor/** linguist-vendored
